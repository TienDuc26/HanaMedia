              <div class="contract-client">Client: Milo · KOL: Hoàng Gia B</div>
            </div>
            <span class="approval-tag" style="background-color: var(--amber-50); color: var(--amber-600); border: 1px solid var(--amber-200);">Chờ ký</span>
          </div>
          <div class="contract-meta">
            <div class="meta-item">
              <div class="meta-label">Giá trị Booking</div>
              <div class="meta-value">18,000,000 đ</div>
            </div>
            <div class="meta-item">
              <div class="meta-label">Chi phí thực tế</div>
              <div class="meta-value">8,500,000 đ</div>
            </div>
            <div class="meta-item">
              <div class="meta-label">Người soạn HĐ</div>
              <div class="meta-value">Phạm Thu Hà</div>
            </div>
          </div>
          <div style="margin-bottom: 12px;">
            <a href="#" style="color: var(--blue-600); font-size: 13px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
              <i class="ti ti-file-text"></i> hop_dong_milo_draft.pdf
            </a>
          </div>
          <div class="contract-actions">
            <div class="sign-section">
              <label style="font-size: 13px; color: var(--ink-2); display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
                <input type="checkbox" id="signCheckbox1" onchange="toggleSignButton('signBtn1', 'signCheckbox1')" style="cursor: pointer; width: 16px; height: 16px;">
                <span style="font-weight: 600;">Xác nhận đã kiểm tra nội dung hợp đồng</span>
              </label>
            </div>
            <button class="btn-mini approve" id="signBtn1" onclick="signContract('Milo', 'Hoàng Gia B', 'signCheckbox1')" disabled style="opacity: 0.5; cursor: not-allowed;">
              <i class="ti ti-signature"></i> Ký hợp đồng
            </button>
          </div>
        </div>

        <div class="contract-card pending" data-status="pending">
          <div class="contract-header">
            <div>
              <div class="contract-title">Hợp đồng Booking Highland Coffee — Mùa tựu trường</div>
              <div class="contract-client">Client: Highland Coffee · KOL: Trần Ngọc A</div>
            </div>
            <span class="approval-tag" style="background-color: var(--amber-50); color: var(--amber-600); border: 1px solid var(--amber-200);">Chờ ký</span>
          </div>
          <div class="contract-meta">
            <div class="meta-item">
              <div class="meta-label">Giá trị Booking</div>
              <div class="meta-value">20,000,000 đ</div>
            </div>
            <div class="meta-item">
              <div class="meta-label">Chi phí thực tế</div>
              <div class="meta-value">9,000,000 đ</div>
            </div>
            <div class="meta-item">
              <div class="meta-label">Người soạn HĐ</div>
              <div class="meta-value">Nguyễn Anh Tuấn</div>
            </div>
          </div>
          <div style="margin-bottom: 12px;">
            <a href="#" style="color: var(--blue-600); font-size: 13px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
              <i class="ti ti-file-text"></i> hop_dong_highland_draft.pdf
            </a>
          </div>
          <div class="contract-actions">
            <div class="sign-section">
              <label style="font-size: 13px; color: var(--ink-2); display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
                <input type="checkbox" id="signCheckbox2" onchange="toggleSignButton('signBtn2', 'signCheckbox2')" style="cursor: pointer; width: 16px; height: 16px;">
                <span style="font-weight: 600;">Xác nhận đã kiểm tra nội dung hợp đồng</span>
              </label>
            </div>
            <button class="btn-mini approve" id="signBtn2" onclick="signContract('Highland Coffee', 'Trần Ngọc A', 'signCheckbox2')" disabled style="opacity: 0.5; cursor: not-allowed;">
              <i class="ti ti-signature"></i> Ký hợp đồng
            </button>
          </div>
        </div>

        <!-- Signed Contracts -->
        <div class="contract-card signed" data-status="signed">
          <div class="contract-header">
            <div>
              <div class="contract-title">Hợp đồng Booking Vinamilk — Tết Sum Vầy 2027</div>
              <div class="contract-client">Client: Vinamilk · KOL: Nguyễn Thị H</div>
            </div>
            <span class="approval-tag" style="background-color: var(--green-50); color: var(--green-600); border: 1px solid var(--green-200);">
              <i class="ti ti-check"></i> Đã ký
            </span>
          </div>
          <div class="contract-meta">
            <div class="meta-item">
              <div class="meta-label">Giá trị Booking</div>
              <div class="meta-value">10,000,000 đ</div>
            </div>
            <div class="meta-item">
              <div class="meta-label">Chi phí thực tế</div>
              <div class="meta-value">4,000,000 đ</div>
            </div>
            <div class="meta-item">
              <div class="meta-label">Ngày ký</div>
              <div class="meta-value">18/08/2026</div>
            </div>
          </div>
          <div style="margin-bottom: 12px;">
            <a href="#" style="color: var(--blue-600); font-size: 13px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
              <i class="ti ti-file-text"></i> hop_dong_vinamilk_signed.pdf
            </a>
            <span style="color: var(--muted); font-size: 12px; margin-left: 8px;">· Hợp đồng chính thức có hiệu lực</span>
          </div>
          <div class="contract-actions">
            <div style="color: var(--muted); font-size: 12px;">
              <i class="ti ti-user-check"></i> Đã ký bởi Giám đốc (Nguyễn Văn A)
            </div>
            <div>
              <button class="btn-mini" onclick="alert('Đang tải hợp đồng...')"><i class="ti ti-download"></i> Tải file</button>
