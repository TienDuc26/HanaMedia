            </div>
            <div class="meta-item">
              <div class="meta-label">Ngày ký</div>
              <div class="meta-value">15/08/2026</div>
            </div>
          </div>
          <div style="margin-bottom: 12px;">
            <a href="#" style="color: var(--blue-600); font-size: 13px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
              <i class="ti ti-file-text"></i> hop_dong_traveloka_signed.pdf
            </a>
            <span style="color: var(--muted); font-size: 12px; margin-left: 8px;">· Hợp đồng chính thức có hiệu lực</span>
          </div>
          <div class="contract-actions">
            <div style="color: var(--muted); font-size: 12px;">
              <i class="ti ti-user-check"></i> Đã ký bởi Giám đốc (Nguyễn Văn A)
            </div>
            <div>
              <button class="btn-mini" onclick="alert('Đang tải hợp đồng...')"><i class="ti ti-download"></i> Tải file</button>
            </div>
          </div>
        </div>

        <div class="contract-card signed" data-status="signed">
          <div class="contract-header">
            <div>
              <div class="contract-title">Hợp đồng Booking Cocoon — Glow Up Your Skin</div>
              <div class="contract-client">Client: Cocoon · KOL: Nguyễn Anh T</div>
            </div>
            <span class="approval-tag" style="background-color: var(--green-50); color: var(--green-600); border: 1px solid var(--green-200);">
              <i class="ti ti-check"></i> Đã ký
            </span>
          </div>
          <div class="contract-meta">
            <div class="meta-item">
              <div class="meta-label">Giá trị Booking</div>
              <div class="meta-value">15,000,000 đ</div>
            </div>
            <div class="meta-item">
              <div class="meta-label">Chi phí thực tế</div>
              <div class="meta-value">6,000,000 đ</div>
            </div>
            <div class="meta-item">
              <div class="meta-label">Ngày ký</div>
              <div class="meta-value">10/08/2026</div>
            </div>
          </div>
          <div style="margin-bottom: 12px;">
            <a href="#" style="color: var(--blue-600); font-size: 13px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
              <i class="ti ti-file-text"></i> hop_dong_cocoon_signed.pdf
            </a>
            <span style="color: var(--muted); font-size: 12px; margin-left: 8px;">· Hợp đồng chính thức có hiệu lực</span>
          </div>
          <div class="contract-actions">
            <div style="color: var(--muted); font-size: 12px;">
              <i class="ti ti-user-check"></i> Đã ký bởi Giám đốc (Nguyễn Văn A)
            </div>
            <div>
              <button class="btn-mini" onclick="alert('Đang tải hợp đồng...')"><i class="ti ti-download"></i> Tải file</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <footer>HanaMedia · Dashboard Giám đốc — dữ liệu minh họa cho mục đích thiết kế giao diện</footer>
  </main>
</div>

<script>
  function switchFilter(e, type) {
    const headers = e.target.parentElement.children;
    for(let h of headers) {
      h.classList.remove('active');
    }
    e.target.classList.add('active');

    const cards = document.querySelectorAll('.contract-card');
    cards.forEach(card => {
      if(type === 'all' || card.getAttribute('data-status') === type) {
        card.style.display = '';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function toggleSignButton(btnId, checkboxId) {
    const checkbox = document.getElementById(checkboxId);
    const btn = document.getElementById(btnId);
    
    if (checkbox.checked) {
      btn.disabled = false;
      btn.style.opacity = '1';
      btn.style.cursor = 'pointer';
    } else {
      btn.disabled = true;
      btn.style.opacity = '0.5';
      btn.style.cursor = 'not-allowed';
    }
  }

  function signContract(client, kol, checkboxId) {
    const checkbox = document.getElementById(checkboxId);
    if (!checkbox || !checkbox.checked) {
      alert('Vui lòng tích chọn "Xác nhận đã kiểm tra nội dung hợp đồng" trước khi ký.');
      return;
    }
    
    if (confirm(`Xác nhận ký hợp đồng cho Booking "${client}" với KOL "${kol}"?\n\nHợp đồng sẽ chính thức có hiệu lực sau khi ký.`)) {
      alert(`Đã ký hợp đồng cho "${client}" thành công!\n\nHợp đồng chính thức có hiệu lực và được ghi lại trong Audit log.`);
      window.location.reload();
    }
  }
</script>
</body>
</html>
