@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng nhập — HanaMedia</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/css/design-system.css" />
  <link rel="stylesheet" href="~/css/login.css" />
  <style>
    .network-modal-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      animation: fadeIn 0.2s ease-out;
    }
    @@keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @@keyframes slideUp {
      from { transform: translateY(20px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    .network-modal {
      background: #fff;
      border-radius: 16px;
      padding: 32px 28px;
      max-width: 420px;
      width: calc(100% - 32px);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
      animation: slideUp 0.25s ease-out;
      text-align: center;
    }
    .network-modal-icon {
      width: 64px;
      height: 64px;
      margin: 0 auto 16px;
      background: #fff5d6;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
    }
    .network-modal-title {
      font-size: 18px;
      font-weight: 700;
      color: #8a5a00;
      margin: 0 0 8px;
    }
    .network-modal-text {
      font-size: 14px;
      color: #555;
      line-height: 1.55;
      margin: 0 0 20px;
    }
    .network-modal-steps {
      background: #f8f8fa;
      border-radius: 10px;
      padding: 12px 16px;
      text-align: left;
      margin-bottom: 20px;
      font-size: 13px;
      color: #444;
    }
    .network-modal-steps strong {
      display: block;
      margin-bottom: 6px;
      color: #222;
      font-size: 13px;
    }
    .network-modal-steps ol {
      margin: 0;
      padding-left: 20px;
    }
    .network-modal-steps li {
      margin: 4px 0;
    }
    .network-modal-btn {
      background: #1d4ed8;
      color: #fff;
      border: none;
      padding: 10px 24px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s;
    }
    .network-modal-btn:hover {
      background: #1e40af;
    }
  </style>
</head>
<body>
  <div class="login-container">
    <div class="login-card">
      <div class="login-header">
        <div class="login-logo">HM</div>
        <h1 class="login-title">HanaMedia</h1>
        <p class="login-subtitle">Chào mừng quay trở lại</p>
      </div>

      @if (ViewBag.Error != null)
      {
        <div class="alert alert-error" style="color: var(--red); background-color: var(--red-bg); padding: 12px; border-radius: 8px; margin-bottom: 16px; font-size: 13.5px; font-weight: 500; border: 1px solid rgba(220, 78, 78, 0.2);">
          @ViewBag.Error
        </div>
      }

      <form method="post" action="/Login">
        @Html.AntiForgeryToken()
        <div class="form-group">
          <label class="form-label" for="username">Tên đăng nhập hoặc Email</label>
          <input type="text" id="username" name="username" class="form-control" placeholder="Nhập email hoặc username..." required autofocus />
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Mật khẩu</label>
          <input type="password" id="password" name="password" class="form-control" placeholder="Nhập mật khẩu..." required />
        </div>

        <button type="submit" class="login-btn">ĐĂNG NHẬP</button>
      </form>

      <div class="login-footer">
        <a href="#">Quên mật khẩu?</a>
      </div>
    </div>
  </div>

  @if (ViewBag.NetworkError != null)
  {
    <div class="network-modal-overlay" id="networkModal">
      <div class="network-modal">
        <div class="network-modal-icon">🛜</div>
        <h3 class="network-modal-title">Không thể đăng nhập</h3>
        <p class="network-modal-text">@ViewBag.NetworkError</p>
        <div class="network-modal-steps">
          <strong>Hướng dẫn:</strong>
          <ol>
            <li>Kết nối vào Wi-Fi hoặc LAN của công ty.</li>
            <li>Đợi vài giây để IP được cập nhật.</li>
            <li>Bấm "Đăng nhập lại" để thử lại.</li>
          </ol>
        </div>
        <button class="network-modal-btn" onclick="document.getElementById('networkModal').remove()">
          Đăng nhập lại
        </button>
      </div>
    </div>
  }
</body>
</html>
