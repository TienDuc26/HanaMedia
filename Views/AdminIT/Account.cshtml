@model HanaMedia.ViewModels.AccountManagementPageViewModel
@{
  var hasEligibleEmployees = Model.EligibleEmployees.Any();
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HanaMedia — Quản lý Tài khoản (AdminIT)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/2.44.0/iconfont/tabler-icons.min.css">
  <link rel="stylesheet" href="~/css/design-system.css">
  <link rel="stylesheet" href="~/css/layout.css">
  <link rel="stylesheet" href="~/css/components.css">
  <link rel="stylesheet" href="~/css/account-management.css" asp-append-version="true">
</head>
<body data-login-history-url="@Url.Action("LoginHistory", "AdminIT")">
<div class="layout" data-page-content>
  <aside class="sidebar">
    <div class="brand">
      <div class="brand-mark">HM</div>
      <div>
        <div class="brand-name">HanaMedia</div>
        <div class="brand-sub">Hệ thống Quản lý Nhân sự</div>
      </div>
    </div>

    <div class="nav-section">Tổng quan</div>
    <a href="@Url.Action("Dashboard", "AdminIT")" class="nav-item"><i class="ti ti-layout-dashboard" aria-hidden="true"></i>Dashboard</a>

    <div class="nav-section">Quản trị hệ thống</div>
    <a href="@Url.Action("Account", "AdminIT")" class="nav-item active" aria-current="page"><i class="ti ti-users" aria-hidden="true"></i>Quản lý tài khoản</a>
    <a href="@Url.Action("AuditLog", "AdminIT")" class="nav-item"><i class="ti ti-shield-check" aria-hidden="true"></i>Nhật ký hệ thống</a>
    <a href="@Url.Action("ConfigSystem", "AdminIT")" class="nav-item"><i class="ti ti-settings" aria-hidden="true"></i>Cấu hình kỹ thuật</a>

    <div class="sidebar-footer">
      <div class="role-pill">
        <div class="avatar">IT</div>
        <div>
          <div class="role-name">@(User.Identity?.Name ?? "AdminIT")</div>
          <div class="role-title">AdminIT</div>
        </div>
      </div>
    </div>
  </aside>

  <main class="main account-main">
    <div class="topbar">
      <div>
        <h1 class="page-title">Quản lý Tài khoản người dùng</h1>
        <div class="page-sub">Cấp tài khoản từ hồ sơ nhân sự, phân quyền và quản lý trạng thái truy cập</div>
      </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage) ||
         !string.IsNullOrWhiteSpace(Model.ErrorMessage) ||
         !string.IsNullOrWhiteSpace(Model.TemporaryPassword))
    {
      <div class="account-message-stack" aria-live="polite">
        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
          <div class="account-notice account-notice-success" role="status">
            <i class="ti ti-circle-check" aria-hidden="true"></i>
            <div>
              <div class="account-notice-title">Thao tác thành công</div>
              <div>@Model.SuccessMessage</div>
            </div>
          </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
          <div class="account-notice account-notice-error" role="alert">
            <i class="ti ti-alert-triangle" aria-hidden="true"></i>
            <div>
              <div class="account-notice-title">Không thể thực hiện</div>
              <div>@Model.ErrorMessage</div>
            </div>
          </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.TemporaryPassword))
        {
          <section class="temporary-password-card" aria-labelledby="temporaryPasswordTitle">
            <div class="temporary-password-icon"><i class="ti ti-key" aria-hidden="true"></i></div>
            <div class="temporary-password-content">
              <h2 id="temporaryPasswordTitle">Mật khẩu tạm thời của <strong>@Model.TemporaryPasswordUsername</strong></h2>
              <p>Mật khẩu chỉ hiển thị trong lần này. Hãy sao chép và gửi cho người dùng qua kênh an toàn.</p>
              <div class="temporary-password-value">
                <code id="temporaryPasswordValue">@Model.TemporaryPassword</code>
                <button type="button" class="btn-mini approve" data-copy-password>
                  <i class="ti ti-copy" aria-hidden="true"></i>
                  <span>Sao chép</span>
                </button>
              </div>
              <span class="copy-feedback" data-copy-feedback aria-live="polite"></span>
            </div>
          </section>
        }
      </div>
    }

    <section class="card" aria-labelledby="accountListTitle">
      <div class="account-action-bar">
        <div>
          <h2 class="card-title" id="accountListTitle">Danh sách tài khoản</h2>
          <div class="card-sub">@Model.Accounts.Count tài khoản phù hợp</div>
        </div>

        <div class="account-toolbar">
          <form method="get" action="@Url.Action("Account", "AdminIT")" class="account-search" role="search">
            <label class="sr-only" for="accountSearch">Tìm tài khoản</label>
            <i class="ti ti-search" aria-hidden="true"></i>
            <input id="accountSearch" name="q" value="@Model.Search" type="search" class="form-control" placeholder="Tài khoản, email, họ tên...">
            <button type="submit" class="btn-mini">Tìm</button>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
              <a href="@Url.Action("Account", "AdminIT")" class="btn-mini account-clear-search">Xóa lọc</a>
            }
          </form>

          <button type="button"
                  class="btn-mini approve account-create-button"
                  data-modal-target="createAccountModal"
                  @(!hasEligibleEmployees ? "disabled" : null)>
            <i class="ti ti-user-plus" aria-hidden="true"></i>
            Tạo tài khoản mới
          </button>
        </div>
      </div>

      @if (!hasEligibleEmployees)
      {
        <div class="account-inline-hint" role="note">
          <i class="ti ti-info-circle" aria-hidden="true"></i>
          Không có nhân sự đang hoạt động nào chưa được cấp tài khoản.
        </div>
      }

      <div class="table-scroll" tabindex="0" role="region" aria-label="Danh sách tài khoản người dùng">
        <table class="account-table">
          <thead>
            <tr>
              <th scope="col">Tài khoản</th>
              <th scope="col">Họ và tên</th>
              <th scope="col">Vai trò</th>
              <th scope="col">Trạng thái</th>
              <th scope="col">Đăng nhập gần nhất</th>
              <th scope="col" class="account-actions-heading">Hành động</th>
            </tr>
          </thead>
          <tbody>
          @if (Model.Accounts.Any())
          {
            @foreach (var account in Model.Accounts)
            {
              var isActive = string.Equals(account.Status, "active", StringComparison.OrdinalIgnoreCase);
              var isLocked = string.Equals(account.Status, "locked", StringComparison.OrdinalIgnoreCase);
              var nextStatus = isActive ? "locked" : "active";
              var canChangeStatus = account.CanLock && (isActive || isLocked);
              var securityStamp = account.SecurityStamp.ToString("D");
              <tr>
                <td>
                  <div class="account-primary">
                    <strong>@account.Username</strong>
                    @if (account.IsCurrentAccount)
                    {
                      <span class="badge badge-info">Bạn</span>
                    }
                  </div>
                  <div class="account-secondary">@account.Email</div>
                </td>
                <td>@account.DisplayName</td>
                <td><span class="dept-chip">@account.RoleName</span></td>
                <td>
                  <span class="status-chip @(isActive ? "status-good" : isLocked ? "status-bad" : "status-warn")">
                    @(isActive ? "Đang hoạt động" : isLocked ? "Đã khóa" : "Không xác định")
                  </span>
                </td>
                <td>
                  @if (account.LastLoginAt.HasValue)
                  {
                    <div>@account.LastLoginAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                    <div class="account-secondary">@(string.IsNullOrWhiteSpace(account.LastLoginIp) ? "Không rõ IP" : account.LastLoginIp)</div>
                  }
                  else
                  {
                    <span class="account-secondary">Chưa có</span>
                  }
                </td>
                <td>
                  <div class="account-row-actions">
                    <button type="button"
                            class="btn-mini"
                            data-login-history
                            data-user-id="@account.Id"
                            data-display-name="@account.DisplayName">
                      <i class="ti ti-history" aria-hidden="true"></i>
                      Lịch sử
                    </button>

                    <button type="button"
                            class="btn-mini"
                            data-change-role
                            data-user-id="@account.Id"
                            data-username="@account.Username"
                            data-display-name="@account.DisplayName"
                            data-current-role="@account.RoleCode"
                            data-security-stamp="@securityStamp"
                            title="@(!account.CanChangeRole ? "Không thể đổi vai trò của tài khoản này." : null)"
                            @(!account.CanChangeRole ? "disabled" : null)>
                      <i class="ti ti-user-cog" aria-hidden="true"></i>
                      Đổi quyền
                    </button>

                    <form method="post"
                          action="@Url.Action("ResetPassword", "AdminIT")"
                          class="account-inline-form"
                          data-confirm="Đặt lại mật khẩu cho tài khoản @account.Username?">
                      @Html.AntiForgeryToken()
                      <input type="hidden" name="UserId" value="@account.Id">
                      <input type="hidden" name="ExpectedSecurityStamp" value="@securityStamp">
                      <button type="submit"
                              class="btn-mini"
                              title="@(account.IsCurrentAccount ? "Không thể tự reset mật khẩu tại trang quản trị." : null)"
                              @(account.IsCurrentAccount ? "disabled" : null)>
                        <i class="ti ti-key" aria-hidden="true"></i>
                        Reset mật khẩu
                      </button>
                    </form>

                    <form method="post"
                          action="@Url.Action("SetAccountStatus", "AdminIT")"
                          class="account-inline-form"
                          data-confirm="@(isActive ? $"Khóa tài khoản {account.Username}?" : $"Mở khóa tài khoản {account.Username}?")">
                      @Html.AntiForgeryToken()
                      <input type="hidden" name="UserId" value="@account.Id">
                      <input type="hidden" name="Status" value="@nextStatus">
                      <input type="hidden" name="ExpectedSecurityStamp" value="@securityStamp">
                      <button type="submit"
                              class="btn-mini @(isActive ? "reject" : "approve")"
                              title="@(!canChangeStatus ? "Không thể thay đổi trạng thái của tài khoản này." : null)"
                              @(!canChangeStatus ? "disabled" : null)>
                        <i class="ti @(isActive ? "ti-lock" : "ti-lock-open")" aria-hidden="true"></i>
                        @(isActive ? "Khóa" : "Mở khóa")
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            }
          }
          else
          {
            <tr>
              <td colspan="6">
                <div class="account-empty-state">
                  <i class="ti ti-users-off" aria-hidden="true"></i>
                  <strong>Không tìm thấy tài khoản</strong>
                  <span>Thử thay đổi từ khóa tìm kiếm hoặc xóa bộ lọc.</span>
                </div>
              </td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    </section>

    <footer>HanaMedia · Quản trị tài khoản và phân quyền truy cập</footer>
  </main>
</div>

<div class="modal-backdrop account-modal" id="createAccountModal" hidden>
  <section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="createAccountTitle">
    <div class="modal-header">
      <div>
        <h2 class="modal-title" id="createAccountTitle">Tạo tài khoản người dùng mới</h2>
        <p class="account-modal-subtitle">Chọn nhân sự chưa có tài khoản và vai trò cần cấp.</p>
      </div>
      <button type="button" class="modal-close" data-modal-close aria-label="Đóng hộp thoại">&times;</button>
    </div>
    <form method="post" action="@Url.Action("CreateAccount", "AdminIT")">
      @Html.AntiForgeryToken()
      <div class="modal-body">
        <div class="form-group">
          <label for="createEmployeeId">Nhân sự</label>
          <select id="createEmployeeId" name="EmployeeId" class="form-control" required data-employee-select>
            <option value="">Chọn nhân sự...</option>
            @foreach (var employee in Model.EligibleEmployees)
            {
              <option value="@employee.Id"
                      data-email="@employee.Email"
                      data-suggested-username="@employee.SuggestedUsername">
                @employee.DisplayName — @employee.Email
              </option>
            }
          </select>
          <div class="field-hint" data-employee-preview>Họ tên, email và tên đăng nhập được lấy từ hồ sơ nhân sự.</div>
        </div>

        <div class="form-group">
          <label for="createRole">Vai trò hệ thống</label>
          <select id="createRole" name="Role" class="form-control" required>
            <option value="">Chọn vai trò...</option>
            @foreach (var role in Model.Roles)
            {
              <option value="@role.Code">@role.Name</option>
            }
          </select>
        </div>

        <div class="alert-box account-security-note">
          <i class="ti ti-shield-lock" aria-hidden="true"></i>
          <div>
            <div class="alert-title">Mật khẩu được tạo tự động</div>
            <div class="alert-desc">Hệ thống chỉ hiển thị mật khẩu tạm thời một lần sau khi tạo thành công.</div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-mini" data-modal-close>Hủy</button>
        <button type="submit" class="btn-mini approve"><i class="ti ti-user-plus" aria-hidden="true"></i> Tạo tài khoản</button>
      </div>
    </form>
  </section>
</div>

<div class="modal-backdrop account-modal" id="changeRoleModal" hidden>
  <section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="changeRoleTitle">
    <div class="modal-header">
      <div>
        <h2 class="modal-title" id="changeRoleTitle">Thay đổi vai trò tài khoản</h2>
        <p class="account-modal-subtitle" data-role-account-name></p>
      </div>
      <button type="button" class="modal-close" data-modal-close aria-label="Đóng hộp thoại">&times;</button>
    </div>
    <form method="post" action="@Url.Action("ChangeRole", "AdminIT")" data-role-form>
      @Html.AntiForgeryToken()
      <input type="hidden" name="UserId" data-role-user-id>
      <input type="hidden" name="ExpectedSecurityStamp" data-role-security-stamp>
      <div class="modal-body">
        <div class="form-group">
          <label for="changeRole">Vai trò mới</label>
          <select id="changeRole" name="Role" class="form-control" required data-role-select>
            @foreach (var role in Model.Roles)
            {
              <option value="@role.Code">@role.Name</option>
            }
          </select>
        </div>
        <div class="alert-box account-security-note">
          <i class="ti ti-alert-triangle" aria-hidden="true"></i>
          <div>
            <div class="alert-title">Quyền truy cập sẽ thay đổi ngay</div>
            <div class="alert-desc">Hãy kiểm tra đúng vai trò trước khi xác nhận.</div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-mini" data-modal-close>Hủy</button>
        <button type="submit" class="btn-mini approve">Cập nhật vai trò</button>
      </div>
    </form>
  </section>
</div>

<div class="modal-backdrop account-modal" id="loginHistoryModal" hidden>
  <section class="modal-card account-history-modal" role="dialog" aria-modal="true" aria-labelledby="loginHistoryTitle">
    <div class="modal-header">
      <div>
        <h2 class="modal-title" id="loginHistoryTitle">Lịch sử kết nối thiết bị</h2>
        <p class="account-modal-subtitle" data-history-account-name></p>
      </div>
      <button type="button" class="modal-close" data-modal-close aria-label="Đóng hộp thoại">&times;</button>
    </div>
    <div class="modal-body account-history-body">
      <div class="history-loading" data-history-loading role="status">
        <span class="account-spinner" aria-hidden="true"></span>
        Đang tải lịch sử...
      </div>
      <div class="account-notice account-notice-error" data-history-error role="alert" hidden>
        <i class="ti ti-alert-triangle" aria-hidden="true"></i>
        <div>Không tải được lịch sử đăng nhập. Vui lòng thử lại.</div>
      </div>
      <div class="account-empty-state" data-history-empty hidden>
        <i class="ti ti-history-off" aria-hidden="true"></i>
        <strong>Chưa có lịch sử đăng nhập</strong>
        <span>Tài khoản này chưa phát sinh sự kiện đăng nhập hoặc đăng xuất.</span>
      </div>
      <div class="table-scroll" data-history-table hidden tabindex="0" role="region" aria-label="Lịch sử đăng nhập">
        <table class="history-table">
          <thead>
            <tr>
              <th scope="col">Thời gian</th>
              <th scope="col">Hành động</th>
              <th scope="col">Thiết bị / Browser</th>
              <th scope="col">Địa chỉ IP</th>
              <th scope="col">Chi tiết</th>
            </tr>
          </thead>
          <tbody data-history-rows></tbody>
        </table>
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn-mini approve" data-modal-close>Đóng</button>
    </div>
  </section>
</div>

<script src="~/js/account-management.js" asp-append-version="true"></script>
</body>
</html>
