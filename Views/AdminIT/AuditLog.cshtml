@using HanaMedia.ViewModels
@model AuditLogPageViewModel
@{
  var currentUsername = User.Identity?.Name ?? "AdminIT";
  var fromValue = Model.Filter.From?.ToString("yyyy-MM-dd");
  var toValue = Model.Filter.To?.ToString("yyyy-MM-dd");
  var firstItemNumber = Model.TotalCount == 0 ? 0 : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
  var lastItemNumber = Model.TotalCount == 0 ? 0 : firstItemNumber + Model.Items.Count - 1;
  var firstVisiblePage = Math.Max(1, Model.CurrentPage - 2);
  var lastVisiblePage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
  if (Model.CurrentPage <= 3)
  {
    lastVisiblePage = Math.Min(Model.TotalPages, 5);
  }
  if (Model.CurrentPage >= Model.TotalPages - 2)
  {
    firstVisiblePage = Math.Max(1, Model.TotalPages - 4);
  }
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HanaMedia — Nhật ký Hệ thống (AdminIT)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/2.44.0/iconfont/tabler-icons.min.css">
  <link rel="stylesheet" href="~/css/design-system.css">
  <link rel="stylesheet" href="~/css/layout.css">
  <link rel="stylesheet" href="~/css/components.css">
  <style>
    .filter-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr) auto;
      gap: 12px;
      margin-bottom: 20px;
      align-items: end;
    }
    .audit-main {
      min-width: 0;
    }
    .audit-table-wrap {
      width: 100%;
      overflow-x: auto;
    }
    .audit-table-wrap table {
      min-width: 980px;
    }
    .audit-pagination {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      flex-wrap: wrap;
      margin-top: 18px;
    }
    .audit-page-link {
      min-width: 36px;
      height: 36px;
      padding: 0 11px;
      border: 1px solid var(--line);
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--ink-2);
      background: #fff;
      text-decoration: none;
      font-size: 13px;
      font-weight: 600;
    }
    .audit-page-link:hover {
      border-color: var(--blue-500);
      color: var(--blue-500);
    }
    .audit-page-link.active {
      border-color: var(--blue-500);
      background: var(--blue-500);
      color: #fff;
    }
    .audit-page-link.disabled {
      color: var(--muted);
      background: var(--blue-50);
      cursor: not-allowed;
      opacity: .65;
    }
    .audit-page-ellipsis {
      color: var(--muted);
      padding: 0 3px;
    }
    @@media (max-width: 991px) {
      .filter-grid {
        grid-template-columns: 1fr 1fr;
      }
    }
  </style>
</head>
<body>
<div class="layout">

  <aside class="sidebar">
    <div class="brand">
      <div class="brand-mark">HM</div>
      <div>
        <div class="brand-name">HanaMedia</div>
        <div class="brand-sub">Hệ thống Quản lý Nhân sự</div>
      </div>
    </div>

    <div class="nav-section">Tổng quan</div>
    <a href="/AdminIT/Dashboard" class="nav-item"><i class="ti ti-layout-dashboard"></i>Dashboard</a>

    <div class="nav-section">Quản trị hệ thống</div>
    <a href="/AdminIT/Account" class="nav-item"><i class="ti ti-users"></i>Quản lý tài khoản</a>
    <a href="/AdminIT/AuditLog" class="nav-item active"><i class="ti ti-shield-check"></i>Nhật ký hệ thống</a>
    <a href="/AdminIT/ConfigSystem" class="nav-item"><i class="ti ti-settings"></i>Cấu hình kỹ thuật</a>

    <div class="sidebar-footer">
      <div class="role-pill">
        <div class="avatar">IT</div>
        <div>
          <div class="role-name">@currentUsername</div>
          <div class="role-title">AdminIT</div>
        </div>
      </div>
    </div>
  </aside>

  <main class="main audit-main">
    <div class="topbar">
      <div>
        <div class="page-title">Nhật ký vận hành hệ thống (Audit Log)</div>
        <div class="page-sub">Ghi nhận toàn bộ thao tác thay đổi dữ liệu của tất cả tài khoản phục vụ mục đích bảo mật và đối soát</div>
      </div>
      <div class="topbar-actions">
        <a asp-controller="AdminIT"
           asp-action="ExportAuditLog"
           asp-route-user="@Model.Filter.User"
           asp-route-actionType="@Model.Filter.ActionType"
           asp-route-module="@Model.Filter.Module"
           asp-route-from="@fromValue"
           asp-route-to="@toValue"
           class="btn-mini approve"
           style="padding: 10px 18px; text-decoration:none;">
          <i class="ti ti-file-text"></i> Xuất báo cáo log
        </a>
      </div>
    </div>

    <div class="card" style="border-color:@(!string.IsNullOrWhiteSpace(Model.ValidationMessage) ? "var(--red)" : Model.FailureCount > 0 ? "var(--amber)" : "var(--green)"); margin-bottom: 20px;">
      <div class="card-head">
        <div class="card-title" style="color:@(!string.IsNullOrWhiteSpace(Model.ValidationMessage) ? "var(--red)" : Model.FailureCount > 0 ? "#8A5A0B" : "var(--green)");">
          <i class="ti @(!string.IsNullOrWhiteSpace(Model.ValidationMessage) || Model.FailureCount > 0 ? "ti-alert-triangle" : "ti-circle-check")"></i>
          Kết quả giám sát nhật ký
        </div>
      </div>
      @if (!string.IsNullOrWhiteSpace(Model.ValidationMessage))
      {
        <div class="alert-box" style="margin-top:0; background:#FDEAEA; border-color:#F5C6CB;">
          <i class="ti ti-alert-circle" style="color:var(--red);"></i>
          <div>
            <div class="alert-title" style="color:#721C24;">Bộ lọc không hợp lệ</div>
            <div class="alert-desc" style="color:#721C24;">@Model.ValidationMessage</div>
          </div>
        </div>
      }
      else if (Model.FailureCount > 0)
      {
        <div class="alert-box" style="margin-top:0;">
          <i class="ti ti-alert-circle"></i>
          <div>
            <div class="alert-title">Có @Model.FailureCount thao tác thất bại trong kết quả đang xem</div>
            <div class="alert-desc">Số liệu được tổng hợp từ các bản ghi khớp với bộ lọc hiện tại. Lọc theo người dùng, thời gian hoặc phân hệ để kiểm tra chi tiết.</div>
          </div>
        </div>
      }
      else
      {
        <div class="alert-box" style="margin-top:0; background:var(--green-bg); border-color:var(--green);">
          <i class="ti ti-circle-check" style="color:var(--green);"></i>
          <div>
            <div class="alert-title" style="color:var(--green);">Không có thao tác thất bại trong kết quả đang xem</div>
            <div class="alert-desc">Không ghi nhận hành động thất bại nào khớp với bộ lọc hiện tại.</div>
          </div>
        </div>
      }
    </div>

    <div class="card">
      <form asp-controller="AdminIT" asp-action="AuditLog" method="get" class="filter-grid">
        <div>
          <label class="info-label" style="margin-bottom:6px; display:block;">Người dùng</label>
          <input type="text" name="user" value="@Model.Filter.User" class="form-control" placeholder="Tên hoặc tài khoản...">
        </div>
        <div>
          <label class="info-label" style="margin-bottom:6px; display:block;">Loại hành động</label>
          <select name="actionType" class="form-control">
            <option value="">Tất cả hành động</option>
            @foreach (var option in Model.ActionOptions)
            {
              if (string.Equals(option.Code, Model.Filter.ActionType, StringComparison.OrdinalIgnoreCase))
              {
                <option value="@option.Code" selected>@option.Label</option>
              }
              else
              {
                <option value="@option.Code">@option.Label</option>
              }
            }
          </select>
        </div>
        <div>
          <label class="info-label" style="margin-bottom:6px; display:block;">Phân hệ (Module)</label>
          <select name="module" class="form-control">
            <option value="">Tất cả phân hệ</option>
            @foreach (var option in Model.ModuleOptions)
            {
              if (string.Equals(option.Code, Model.Filter.Module, StringComparison.OrdinalIgnoreCase))
              {
                <option value="@option.Code" selected>@option.Label</option>
              }
              else
              {
                <option value="@option.Code">@option.Label</option>
              }
            }
          </select>
        </div>
        <div>
          <label class="info-label" style="margin-bottom:6px; display:block;">Từ ngày</label>
          <input type="date" name="from" value="@fromValue" class="form-control">
        </div>
        <div>
          <label class="info-label" style="margin-bottom:6px; display:block;">Đến ngày</label>
          <input type="date" name="to" value="@toValue" class="form-control">
        </div>
        <button type="submit" class="btn-mini approve" style="padding: 10px 16px;">Lọc log</button>
      </form>

      <div class="audit-table-wrap">
      <table>
        <thead>
          <tr>
            <th>Thời gian</th>
            <th>Người thực hiện</th>
            <th>Hành động</th>
            <th>Phân hệ</th>
            <th>Nội dung tác động chi tiết</th>
            <th>IP nguồn</th>
          </tr>
        </thead>
        <tbody>
          @if (Model.Items.Count == 0)
          {
            <tr>
              <td colspan="6" style="padding:36px 20px; text-align:center; color:var(--muted);">
                <i class="ti ti-file-search" style="font-size:28px; display:block; margin-bottom:8px;"></i>
                Không có nhật ký nào phù hợp với bộ lọc.
              </td>
            </tr>
          }
          else
          {
            @foreach (var item in Model.Items)
            {
              <tr>
                <td style="white-space:nowrap;">@(item.OccurredAt.HasValue ? item.OccurredAt.Value.ToString("dd/MM/yyyy HH:mm") : "—")</td>
                <td>
                  <strong>@item.ActorDisplayName</strong>
                  @if (!string.IsNullOrWhiteSpace(item.RoleName))
                  {
                    <span title="Vai trò hiện tại"> (@item.RoleName hiện tại)</span>
                  }
                  @if (!string.IsNullOrWhiteSpace(item.Username) && !string.Equals(item.Username, item.ActorDisplayName, StringComparison.OrdinalIgnoreCase))
                  {
                    <div style="font-size:12px; color:var(--muted); margin-top:2px;">@item.Username</div>
                  }
                </td>
                <td><span class="badge @item.BadgeClass" title="@item.ActionType">@item.ActionLabel</span></td>
                <td>@item.ModuleLabel</td>
                <td>@item.Detail</td>
                <td>@item.IpAddress</td>
              </tr>
            }
          }
        </tbody>
      </table>
      </div>

      <div style="display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-top:16px; color:var(--muted); font-size:13px;">
        @if (Model.TotalCount == 0)
        {
          <span>Không có bản ghi phù hợp.</span>
        }
        else
        {
          <span>Đang hiển thị @firstItemNumber–@lastItemNumber trên @Model.TotalCount bản ghi phù hợp.</span>
          <span>Trang @Model.CurrentPage/@Model.TotalPages · @Model.PageSize bản ghi mỗi trang</span>
        }
      </div>

      @if (Model.TotalPages > 1)
      {
        <nav class="audit-pagination" aria-label="Phân trang nhật ký hệ thống">
          @if (Model.CurrentPage > 1)
          {
            <a asp-controller="AdminIT" asp-action="AuditLog"
               asp-route-user="@Model.Filter.User" asp-route-actionType="@Model.Filter.ActionType"
               asp-route-module="@Model.Filter.Module" asp-route-from="@fromValue" asp-route-to="@toValue"
               asp-route-page="@(Model.CurrentPage - 1)" class="audit-page-link" aria-label="Trang trước">
              <i class="ti ti-chevron-left"></i> Trước
            </a>
          }
          else
          {
            <span class="audit-page-link disabled" aria-disabled="true"><i class="ti ti-chevron-left"></i> Trước</span>
          }

          @if (firstVisiblePage > 1)
          {
            <a asp-controller="AdminIT" asp-action="AuditLog"
               asp-route-user="@Model.Filter.User" asp-route-actionType="@Model.Filter.ActionType"
               asp-route-module="@Model.Filter.Module" asp-route-from="@fromValue" asp-route-to="@toValue"
               asp-route-page="1" class="audit-page-link">1</a>
            @if (firstVisiblePage > 2)
            {
              <span class="audit-page-ellipsis">…</span>
            }
          }

          @for (var pageNumber = firstVisiblePage; pageNumber <= lastVisiblePage; pageNumber++)
          {
            if (pageNumber == Model.CurrentPage)
            {
              <span class="audit-page-link active" aria-current="page">@pageNumber</span>
            }
            else
            {
              <a asp-controller="AdminIT" asp-action="AuditLog"
                 asp-route-user="@Model.Filter.User" asp-route-actionType="@Model.Filter.ActionType"
                 asp-route-module="@Model.Filter.Module" asp-route-from="@fromValue" asp-route-to="@toValue"
                 asp-route-page="@pageNumber" class="audit-page-link">@pageNumber</a>
            }
          }

          @if (lastVisiblePage < Model.TotalPages)
          {
            @if (lastVisiblePage < Model.TotalPages - 1)
            {
              <span class="audit-page-ellipsis">…</span>
            }
            <a asp-controller="AdminIT" asp-action="AuditLog"
               asp-route-user="@Model.Filter.User" asp-route-actionType="@Model.Filter.ActionType"
               asp-route-module="@Model.Filter.Module" asp-route-from="@fromValue" asp-route-to="@toValue"
               asp-route-page="@Model.TotalPages" class="audit-page-link">@Model.TotalPages</a>
          }

          @if (Model.CurrentPage < Model.TotalPages)
          {
            <a asp-controller="AdminIT" asp-action="AuditLog"
               asp-route-user="@Model.Filter.User" asp-route-actionType="@Model.Filter.ActionType"
               asp-route-module="@Model.Filter.Module" asp-route-from="@fromValue" asp-route-to="@toValue"
               asp-route-page="@(Model.CurrentPage + 1)" class="audit-page-link" aria-label="Trang sau">
              Sau <i class="ti ti-chevron-right"></i>
            </a>
          }
          else
          {
            <span class="audit-page-link disabled" aria-disabled="true">Sau <i class="ti ti-chevron-right"></i></span>
          }
        </nav>
      }
    </div>

    <footer>HanaMedia · Dashboard AdminIT</footer>
  </main>
</div>
</body>
</html>
